# Docker Compose supplies DATABASE_URL internally. Set it only when running
# the API outside Docker against a separate PostgreSQL instance.
# DATABASE_URL=postgres://norwescan:norwescan@localhost:5434/norwescan

ADMIN_ID=23-02330
ADMIN_PASSWORD=replace-with-a-long-private-organizer-password
MANAGER_USERNAME=system-manager
MANAGER_PASSWORD=replace-with-a-different-long-private-manager-password

# Exact HTTPS origin(s) of the Vercel PWA, comma-separated, with no path or
# trailing slash. Example: https://norwescan.vercel.app,https://app.example.com
WEB_ORIGINS=

# Public hostname served by Caddy with automatic HTTPS. Used by deploy.sh.
# Do not include https:// or a path.
API_DOMAIN=api.example.com
