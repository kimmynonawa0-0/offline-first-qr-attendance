# On a physical phone, use the computer's reachable LAN IP or an HTTPS API URL.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:3000

# Production: the Vercel-hosted PWA calls the Oracle-hosted API.
# Set this to the exact HTTPS API origin, such as https://norwescan-api.example.com.
# EXPO_PUBLIC_API_URL=https://norwescan-api.example.com
