{
  "expo": {
    "name": "NORWE-SCAN",
    "slug": "norwe-scan",
    "scheme": "norwescan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edgesync.norwescan"
    },
    "android": {
      "package": "com.edgesync.norwescan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NORWE-SCAN to scan attendance QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ]
  }
}
